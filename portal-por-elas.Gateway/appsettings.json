{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "dev-auth-route": {
        "ClusterId": "portal-por-elas-dev-cluster",
        "RateLimiterPolicy": "gateway-auth-limit",
        "Match": {
          "Path": "/portal-por-elas/dev/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portal-por-elas/dev" },
          {
            "RequestHeader": "X-Environment",
            "Set": "Development"
          },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "PortalPorElas-Gateway"
          }
        ]
      },
      "dev-geral-route": {
        "ClusterId": "portal-por-elas-dev-cluster",
        "RateLimiterPolicy": "gateway-default-limit",
        "Match": {
          "Path": "/portal-por-elas/dev/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portal-por-elas/dev" },
          {
            "RequestHeader": "X-Environment",
            "Set": "Development"
          },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "PortalPorElas-Gateway"
          }
        ]
      },
      "prod-auth-route": {
        "ClusterId": "portal-por-elas-prod-cluster",
        "RateLimiterPolicy": "gateway-auth-limit",
        "Match": {
          "Path": "/portal-por-elas/prod/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portal-por-elas/prod" },
          {
            "RequestHeader": "X-Environment",
            "Set": "Production"
          },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "PortalPorElas-Gateway"
          }
        ]
      },
      "prod-geral-route": {
        "ClusterId": "portal-por-elas-prod-cluster",
        "RateLimiterPolicy": "gateway-default-limit",
        "Match": {
          "Path": "/portal-por-elas/prod/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portal-por-elas/prod" },
          {
            "RequestHeader": "X-Environment",
            "Set": "Production"
          },
          {
            "RequestHeader": "X-Forwarded-By",
            "Set": "PortalPorElas-Gateway"
          }
        ]
      }
    },
    "Clusters": {
      "portal-por-elas-dev-cluster": {
        "Destinations": {
          "api-dev": {
            "Address": "http://api-dev:8080/"
          }
        }
      },
      "portal-por-elas-prod-cluster": {
        "Destinations": {
          "api-prod": {
            "Address": "http://api-prod:8080/"
          }
        }
      }
    }
  }
}